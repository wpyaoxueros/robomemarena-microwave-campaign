# Copy outside the Git repository as runtime.local.env, then replace every path.
# Do not commit that local file: it contains machine-local model and data paths.

export OPENPI_ROOT=/path/to/openpi
export INFER_ROOT=/path/to/openpi_inference
export TARGET_LIBERO_PATH=/path/to/official/libero/source
export OFFICIAL_ROOT=/path/to/clean/OpenHelix-RoboMemArena-d9f83ac
export OUTPUT_ROOT=/path/to/external/output/root

export VLA_POLICY=/path/to/original-fullvlm-v2-noflip-35999
export VLA_NORM_FILE=/path/to/original-fullvlm-v2-noflip-35999/assets/robomemarena_fullvlm_v2_noflip_dataset_v2/norm_stats.json
export VLA_LABEL=fullvlm_v2_robomemarena_noflip_v2_bs128_4gpu_20260507_183338/35999

# Set these per archived task invocation.
export VLM_CKPT=/path/to/task-specific-vlm-checkpoint
export VLM_LABEL=task-specific-vlm-checkpoint-label

# Frozen local rollout implementation paths. They are local interfaces, not
# checkpoint locations, and must point to the original archived runner files.
export ARCHIVED_SYNC_RUNNER=/path/to/run_tasks2_26_sync_hold_eval.sh
export ARCHIVED_TASKS_EVAL=/path/to/eval_tasks2_26_sync_endpose_hold_officialscore.py
export TASK1_RUNNER=/path/to/run_task1_officialscore.sh
export TASK1_EVAL=/path/to/eval_task1_qwen3_sync_endpose_hold_officialscore.py
export ENDPOSE_HOLD_TARGETS_JSON=/path/to/tasks2_26_endpose_targets.json
export ENDPOSE_TARGET_PASSAGE_COUNTS_GENERAL=/path/to/general_passage_counts.json
export ENDPOSE_TARGET_PASSAGE_COUNTS_DRAWER=/path/to/drawer_passage_counts.json
